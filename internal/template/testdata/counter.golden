# CounterSource with the counters Deaths = 1234567, neg = -1234, x = 5 and
# xdisplay = 7 (spec counters-and-quotes.md, B1, B4).
in:  "$deaths $DEATHS $Deathsx"
out: "1234567 1234567 1234567x"

in:  "$deathsdisplay $deathsdisplayed"
out: "1,234,567 1,234,567ed"

in:  "$negdisplay"
out: "-1,234"

# a counter wins over the formatted value of another one with the same length
in:  "$x $xdisplay $xdisplays"
out: "5 7 7s"

in:  "$unknown"
out: "$unknown"

