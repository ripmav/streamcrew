// SPDX-License-Identifier: Apache-2.0
//
// Renovate configuration (Code-ADR-0001). Renovate runs as the Renovate
// GitHub App on this repository; Dependabot is not used.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Third-party actions stay pinned to commit SHAs, with the version as comment.
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/Berlin',
  // Monday morning, together with the weekly govulncheck run of the CI.
  schedule: ['* 0-5 * * 1'],
  semanticCommits: 'enabled',
  // Releases have to be three days old before Renovate proposes them. This
  // lowers the risk of broken or compromised releases.
  minimumReleaseAge: '3 days',
  // Security fixes from the OSV database come immediately, outside the schedule.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  packageRules: [
    {
      description: 'Go modules: one pull request for all minor and patch updates',
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Go modules',
      semanticCommitType: 'build',
    },
    {
      description: 'Go modules: major updates separately',
      matchManagers: ['gomod'],
      matchUpdateTypes: ['major'],
      semanticCommitType: 'build',
    },
    {
      description: 'Keep the go directive in go.mod at the latest stable release (Code-ADR-0001)',
      matchManagers: ['gomod'],
      matchDatasources: ['golang-version'],
      rangeStrategy: 'bump',
      groupName: 'Go',
      semanticCommitType: 'build',
    },
    {
      // The github-actions manager also covers the golangci-lint version of
      // golangci-lint-action and the Go version of setup-go.
      description: 'CI: actions and tool versions in workflows in one pull request',
      matchManagers: ['github-actions', 'custom.regex'],
      groupName: 'CI',
      semanticCommitType: 'ci',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Go tools pinned with "go run <module>@<version>"',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/', '/^scripts/[^/]+\\.sh$/'],
      matchStrings: ['go run (?<depName>[\\w./-]+)@(?<currentValue>v\\d\\S*)'],
      datasourceTemplate: 'go',
    },
  ],
}
