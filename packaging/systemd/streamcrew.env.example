# SPDX-License-Identifier: MIT
#
# /etc/systemd/system/streamcrew.env — root-only (0600). The values are
# secrets. STREAMCREW_TOKEN is the bootstrap admin token: at the first start
# the core stores it as the admin token of the API (ADR-0013 §5); with
# stored tokens it is ignored. After the first start, further tokens are
# created with `streamcrew token create`. STREAMCREW_SECRET_KEY is the key
# that encrypts platform tokens at rest (Code-ADR-0012).
STREAMCREW_TOKEN=
STREAMCREW_SECRET_KEY=
